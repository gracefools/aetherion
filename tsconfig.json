{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "jsx": "react",
    "skipLibCheck": true,
    "isolatedModules": false,
    "allowImportingTsExtensions": false
  },
  "include": ["shared/src", "server/src", "client/src", "tests", "scripts", "types"]
}
