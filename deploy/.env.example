# Copy to /etc/aetherion.env (systemd) or export before `npm run start:prod`.
NODE_ENV=production
PORT=8080
HOST=127.0.0.1                     # behind a reverse proxy; 0.0.0.0 to listen publicly
DATABASE_URL=postgres://aetherion:CHANGE_ME@127.0.0.1:5432/aetherion
REDIS_URL=redis://127.0.0.1:6379

# --- security ---
METRICS_TOKEN=CHANGE_ME_long_random_string   # without it /api/metrics answers loopback only
TRUST_PROXY=1                      # number of reverse proxies in front (0 if none): whose X-Forwarded-For entry to trust
ALLOWED_ORIGINS=                   # extra origins allowed to open the game socket, comma separated
MAX_CONNECTIONS=2000
MAX_CONNECTIONS_PER_IP=20
AUTH_RATE_LIMIT=20                 # login/register attempts per address per minute

# --- game tuning (no code change needed) ---
ROOM_CAPACITY=150                  # players per channel before a new channel opens
DROP_RATE=1
GOLD_RATE=1
WORLD_BOSS_RESPAWN_SCALE=1
RECONNECT_GRACE_MS=10000
AUTOSAVE_MS=30000
MAX_CHARACTERS=4
